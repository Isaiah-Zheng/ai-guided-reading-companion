{
  "manifest_version": 3,
  "name": "AI Guided Reading Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Selective bilingual reading help, alongside the original text.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open Reading Companion"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8001"}
}
