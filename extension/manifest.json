{
  "manifest_version": 3,
  "name": "AI Reading Tutor",
  "version": "0.3.1",
  "description": "Saved book pages and bilingual word help on webpages, powered by local AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://en.wikipedia.org/*"
  ],
  "action": {
    "default_title": "Read with AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "options_page": "reader.html",
  "commands": {
    "toggle-web": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle bilingual word help on the active webpage"
    }
  }
}